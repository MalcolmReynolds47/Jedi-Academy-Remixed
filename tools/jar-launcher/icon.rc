1 ICON "../../shared/icons/JAR.ico"

#include <windows.h>
#include "../../shared/qcommon/jar_release.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION JAR_RELEASE_FILE_NUMBER
 PRODUCTVERSION JAR_RELEASE_FILE_NUMBER
 FILEFLAGSMASK 0x17L
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
#ifdef JAR_MP_LAUNCHER
   VALUE "FileDescription", "Jedi Academy Remixed Multiplayer Launcher"
#else
   VALUE "FileDescription", "Jedi Academy Remixed Singleplayer Launcher"
#endif
   VALUE "ProductName", "Jedi Academy Remixed"
   VALUE "FileVersion", JAR_RELEASE_FILE_STRING
   VALUE "ProductVersion", JAR_RELEASE_FILE_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
